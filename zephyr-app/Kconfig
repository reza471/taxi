# Application options. Everything else comes from Zephyr.

config TAXI_OTA
	bool "Firmware update over HTTPS (OTA)"
	default y
	depends on BOOTLOADER_MCUBOOT
	select FLASH
	select FLASH_MAP
	select STREAM_FLASH
	select IMG_MANAGER
	select IMG_ERASE_PROGRESSIVELY
	help
	  The meter downloads a signed MCUboot image into slot 1 when the server offers a newer
	  version, MCUboot checks the signature and swaps it in, and the new image must prove itself
	  (talk to the server) before it is confirmed. Without confirmation the old image comes back.
	  Needs a sysbuild build with MCUboot (see zephyr-app/README.md).

config TAXI_SERVER_HOST
	string "Server host name or IP address"
	default "node.raxitaxi.ir"
	help
	  The tariff / trip server. For a test on your own PC put its IP here, for example
	  west build ... -- -DCONFIG_TAXI_SERVER_HOST=\"203.0.113.7\" -DCONFIG_TAXI_SERVER_PORT=8443

config TAXI_SERVER_PORT
	int "Server HTTPS port"
	default 443
	range 1 65535

config TAXI_NTP_HOST
	string "NTP server (host name or IP)"
	default "ntp.day.ir"
	help
	  The mock server can also answer NTP (UDP 123) for tests on a local network.

source "Kconfig.zephyr"
